# Ultron Proxy Configuration
ULTRON_HOST=127.0.0.1
ULTRON_PORT=8787
ULTRON_FALLBACK_PORT=20128

# Upstream LLM Endpoints
ANTHROPIC_UPSTREAM_URL=https://api.anthropic.com
OPENAI_UPSTREAM_URL=https://api.openai.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local Open-Source LLM Gateway (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Compression Settings
CAVEMAN_MODE=adaptive
HEADROOM_ENABLED=true
CLAUDEMEM_ENABLED=true
OMNIROUTE_ENABLED=true
CACHE_GUARD_ENABLED=true
